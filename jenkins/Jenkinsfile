// Declarative Jenkins pipeline — mirrors .github/workflows/ci.yml so
// Jenkins + GHA can run side-by-side as a portfolio artifact.

pipeline {
    agent {
        docker {
            image 'python:3.11-slim'
            args '-u 0:0'
        }
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
        PYTHONDONTWRITEBYTECODE = '1'
    }

    stages {
        stage('install') {
            steps {
                sh '''
                    apt-get update && apt-get install -y --no-install-recommends build-essential librdkafka-dev
                    python -m pip install --upgrade pip
                    pip install -e ".[dev,generator,producer,spark]"
                '''
            }
        }

        stage('lint') {
            steps {
                sh 'ruff check .'
                sh 'ruff format --check .'
            }
        }

        stage('typecheck') {
            steps { sh 'mypy src/' }
        }

        stage('test') {
            steps { sh 'pytest -q --junitxml=test-results.xml' }
            post {
                always { junit allowEmptyResults: true, testResults: 'test-results.xml' }
            }
        }

        stage('terraform validate') {
            steps {
                sh '''
                    curl -fsSL https://releases.hashicorp.com/terraform/1.9.5/terraform_1.9.5_linux_amd64.zip -o /tmp/tf.zip
                    unzip -q /tmp/tf.zip -d /usr/local/bin
                    terraform -chdir=terraform init -backend=false
                    terraform -chdir=terraform validate
                '''
            }
        }
    }

    post {
        failure {
            echo 'CI failed — notify #rides-platform if this is on main.'
        }
    }
}
